# Build context hygiene. The image is built from the repo root and needs only
# backend/ and frontend/ — everything else is dead weight in the context.
.git
.github
docs
.scratch
.agents
.pi

# dependencies and build output are produced inside the image
node_modules
**/node_modules
frontend/dist
backend/web

# local data and scratch
*.sqlite3
*.db
*.db-shm
*.db-wal
