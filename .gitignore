# Passcryptum — ignore rules for this repo only (Go + Vue + Docker).
# Nothing here is inherited from another stack; add a rule only for a file
# this project actually produces.

# --- dependencies -----------------------------------------------------------
node_modules/

# --- build output -----------------------------------------------------------
# The SPA is built at image build time and embedded into the Go binary; the
# checked-in placeholder under backend/web is generated by e2e/run.sh too.
backend/web/
build/
dist/

# --- test output ------------------------------------------------------------
frontend/test-results/
frontend/playwright-report/
frontend/coverage/
*.out

# --- local data -------------------------------------------------------------
# The server's SQLite file (and its WAL sidecars) can land anywhere the CLI is
# run from; the master secret lives on the user's devices, not here.
passcryptum.db
passcryptum.db-shm
passcryptum.db-wal
*.sqlite3

# --- editor / OS ------------------------------------------------------------
.idea/
.vscode/
.DS_Store
*.swp
*~

# --- local-only tooling and notes -------------------------------------------
# Agent skills, plans and scratch notes are development conveniences; they are
# deliberately not part of the repository.
.agents/
.pi/
.scratch/

# --- secrets ----------------------------------------------------------------
.env
.env.*
!.env.example
